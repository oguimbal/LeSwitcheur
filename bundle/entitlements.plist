<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        Hardened runtime blocks Apple Events by default. Required so
        NSAppleEventsUsageDescription / Chrome + Safari tab queries keep
        working in the notarised build.
    -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
